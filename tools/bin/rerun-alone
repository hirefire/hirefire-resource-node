#!/usr/bin/env node
"use strict"

const fs = require("fs")
const path = require("path")
const { runDirectory } = require("../lib/paths")
const { cells, cellId, prepareLane, runCell } = require("../lib/matrix")

const args = process.argv.slice(2)
const [id, testName, timesText] = args.filter(
  (entry) => !entry.startsWith("--"),
)
if (!id || !testName) {
  console.error(
    "usage: tools/bin/rerun-alone <cell id> <test name> [times] [--seed=<n>] [--file]",
  )
  process.exit(64)
}
const times = Number(timesText || 20)
const seedArg = args.find((entry) => entry.startsWith("--seed="))
const seed = seedArg ? Number(seedArg.split("=")[1]) : undefined
const wholeFile = args.includes("--file")

async function main() {
  const cell = cells().find((entry) => cellId(entry) === id)
  if (!cell) throw new Error(`no cell ${id}`)
  const directory = runDirectory("alone")
  for (const sub of ["logs", "jest", "coverage"]) {
    fs.mkdirSync(path.join(directory, sub), { recursive: true })
  }
  const lane = await prepareLane(
    cell.node,
    "2",
    path.join(directory, "logs", `lane-${cell.node}.log`),
  )
  const pattern = testName.replace(/[^A-Za-z0-9]+/g, ".")
  let passed = 0
  const failures = {}
  for (let index = 0; index < times; index += 1) {
    const outcome = await runCell(lane, cell, {
      directory,
      seed,
      extra: wholeFile ? [] : ["-t", pattern],
    })
    if (outcome.status === "pass") passed += 1
    for (const entry of outcome.failed) {
      failures[entry.test] = (failures[entry.test] || 0) + 1
    }
  }
  const line = {
    cell: id,
    test: testName,
    alone: !wholeFile,
    seed: seed ?? null,
    runs: times,
    passed,
    failures,
  }
  fs.appendFileSync(
    path.join(directory, "reruns.jsonl"),
    JSON.stringify(line) + "\n",
  )
  console.log(JSON.stringify(line))
}

main().catch((error) => {
  console.error(error)
  process.exit(2)
})
