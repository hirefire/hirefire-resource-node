#!/usr/bin/env node
"use strict"

const { execFileSync, spawn } = require("child_process")
const fs = require("fs")
const path = require("path")
const { createCoverageMap } = require("istanbul-lib-coverage")
const { root, results, sandboxes, nodeVersions } = require("../lib/paths")
const { cells, cellId } = require("../lib/matrix")
const { generate, apply } = require("../lib/mutation/generator")

const NODE_MAJOR = "26"
const CORE_TREES = Number(process.env.TOOLS_CORE_TREES || 6)
const IN_FLIGHT = Number(process.env.TOOLS_MUTANTS_IN_FLIGHT || 10)
const CORE_TIMEOUT_MS = 90_000
const CELL_TIMEOUT_MS = 60_000
const MUTANT_TIMEOUT_FLOOR_MS = 15_000
const MUTANT_TIMEOUT_FACTOR = 8
const SLOTS = {
  "bullmq-4": 2,
  "bullmq-5": 3,
  "bullmq-6": 4,
  "bull-4": 5,
  "pg-boss-10": 8,
  "pg-boss-11": 9,
  "pg-boss-12": 1,
}
const directory = path.join(results, process.env.TOOLS_RUN || "mutation")
const record = path.join(directory, "mutants.jsonl")
const node = path.join(
  execFileSync("mise", ["where", `node@${nodeVersions()[NODE_MAJOR]}`], {
    encoding: "utf8",
  }).trim(),
  "bin",
  "node",
)

function sourceFiles(dir) {
  return fs
    .readdirSync(dir, { withFileTypes: true })
    .flatMap((entry) => {
      const full = path.join(dir, entry.name)
      if (entry.isDirectory()) return sourceFiles(full)
      return entry.name.endsWith(".js") ? [path.relative(root, full)] : []
    })
    .sort()
}

function packageCells() {
  return cells()
    .filter(
      (cell) => String(cell.node) === NODE_MAJOR && cell.package !== "core",
    )
    .map((cell) => ({
      ...cell,
      id: cellId(cell),
      key: cellId(cell).replace(`node${NODE_MAJOR}-`, ""),
    }))
}

function tree(name) {
  return path.join(sandboxes, `mut-${name}`)
}

function sh(command, args, options = {}) {
  return execFileSync(command, args, { encoding: "utf8", ...options })
}

function failedTests(report, cwd) {
  if (!fs.existsSync(report)) return []
  const failed = []
  for (const suite of JSON.parse(fs.readFileSync(report, "utf8")).testResults) {
    const file = path.relative(cwd, suite.name)
    if (suite.status === "failed" && suite.assertionResults.length === 0) {
      failed.push(`${file}: (suite did not run)`)
    }
    for (const assertion of suite.assertionResults) {
      if (assertion.status === "failed") {
        failed.push(`${file}: ${assertion.fullName}`)
      }
    }
  }
  return failed
}

function jest(cwd, args, { timeout, guard }) {
  return new Promise((resolve) => {
    const started = Date.now()
    const report = path.join(cwd, "tools-jest-report.json")
    fs.rmSync(report, { force: true })
    const env = {
      ...process.env,
      PATH: `${path.dirname(node)}:${process.env.PATH}`,
      TOOLS_NET_GUARD: guard,
    }
    delete env.DATABASE_URL
    delete env.REDIS_URL
    const child = spawn(
      node,
      [
        "node_modules/jest/bin/jest.js",
        `--setupFilesAfterEnv=${path.join(cwd, "test", "support.js")}`,
        `--setupFilesAfterEnv=${path.join(
          cwd,
          "tools",
          "lib",
          "net_guard.js",
        )}`,
        "--forceExit",
        "--ci",
        "--json",
        `--outputFile=${report}`,
        ...args,
      ],
      {
        cwd,
        env,
        detached: true,
        stdio: ["ignore", "ignore", "ignore"],
      },
    )
    let timedOut = false
    const timer = setTimeout(() => {
      timedOut = true
      try {
        process.kill(-child.pid, "SIGKILL")
      } catch {}
    }, timeout)
    child.on("close", (code) => {
      clearTimeout(timer)
      resolve({
        code,
        timedOut,
        seconds: (Date.now() - started) / 1000,
        failed: code === 0 || timedOut ? [] : failedTests(report, cwd),
      })
    })
  })
}

function cellArgs(cell) {
  const args = ["--bail"]
  if (["bullmq", "bull", "pg-boss"].includes(cell.package)) {
    args.push("--runInBand")
  }
  if (cell.package === "@nestjs/platform-express" && cell.major >= 12) {
    args.push("--runner=jest-light-runner")
  }
  args.push(cell.test)
  return args
}

function prepare() {
  fs.mkdirSync(directory, { recursive: true })
  const base = tree("core-1")
  sh(path.join(root, "tools", "bin", "sandbox"), [base])
  if (!fs.existsSync(path.join(base, "node_modules"))) {
    sh(path.join(path.dirname(node), "npm"), ["ci", "--silent"], {
      cwd: base,
      env: {
        ...process.env,
        PATH: `${path.dirname(node)}:${process.env.PATH}`,
      },
    })
  }
  for (let index = 2; index <= CORE_TREES; index += 1) {
    const target = tree(`core-${index}`)
    sh(path.join(root, "tools", "bin", "sandbox"), [target])
    if (!fs.existsSync(path.join(target, "node_modules"))) {
      sh("cp", ["-cR", path.join(base, "node_modules"), target])
    }
  }
  for (const cell of packageCells()) {
    const target = tree(cell.key)
    const slot = SLOTS[cell.key]
    sh(
      path.join(root, "tools", "bin", "sandbox"),
      slot ? [target, String(slot)] : [target],
    )
    if (!fs.existsSync(path.join(target, "node_modules"))) {
      sh("cp", ["-cR", path.join(base, "node_modules"), target])
      const packages =
        cell.package === "bullmq" || cell.package === "bull"
          ? [`${cell.package}@${cell.major}`, "ioredis"]
          : cell.package === "@nestjs/platform-express"
            ? [
                `${cell.package}@${cell.major}`,
                `@nestjs/core@${cell.major}`,
                `@nestjs/common@${cell.major}`,
                "reflect-metadata",
                ...(cell.major >= 12 ? ["jest-light-runner"] : []),
              ]
            : [`${cell.package}@${cell.major}`]
      sh(
        path.join(path.dirname(node), "npm"),
        [
          "install",
          ...packages,
          "--no-save",
          "--save-peer",
          "--no-audit",
          "--no-fund",
          "--silent",
        ],
        {
          cwd: target,
          env: {
            ...process.env,
            PATH: `${path.dirname(node)}:${process.env.PATH}`,
          },
        },
      )
    }
    console.log(`tree ${cell.key}`)
  }
}

async function coverage() {
  const base = tree("core-1")
  const ignore = cells()
    .filter((cell) => cell.package !== "core")
    .map((cell) => cell.test)
  const tests = sh("find", ["test", "-name", "*.test.js"], { cwd: base })
    .trim()
    .split("\n")
    .filter((file) => !ignore.some((prefix) => file.startsWith(prefix)))
    .sort()
  const byFile = {}
  const seconds = {}
  for (const test of tests) {
    const out = path.join(directory, "coverage-core", test.replace(/\W+/g, "-"))
    fs.rmSync(out, { recursive: true, force: true })
    const outcome = await jest(
      base,
      [
        "--runInBand",
        "--coverage",
        "--coverageReporters=json",
        `--coverageDirectory=${out}`,
        test,
      ],
      {
        timeout: CORE_TIMEOUT_MS,
        guard: path.join(directory, "net-guard.txt"),
      },
    )
    if (outcome.code !== 0) throw new Error(`${test} fails without a mutation`)
    seconds[test] = outcome.seconds
    const raw = JSON.parse(
      fs.readFileSync(path.join(out, "coverage-final.json"), "utf8"),
    )
    const rebased = {}
    for (const data of Object.values(raw)) {
      const index = data.path.lastIndexOf("/src/")
      if (index === -1) continue
      const rel = data.path.slice(index + 1)
      rebased[rel] = { ...data, path: rel }
    }
    const map = createCoverageMap(rebased)
    for (const rel of map.files()) {
      const lines = map.fileCoverageFor(rel).getLineCoverage()
      const covered = Object.keys(lines)
        .filter((line) => lines[line] > 0)
        .map(Number)
      if (covered.length === 0) continue
      byFile[rel] = byFile[rel] || {}
      byFile[rel][test] = covered
    }
    console.log(`${test}: ${outcome.seconds.toFixed(1)} s`)
  }
  fs.writeFileSync(
    path.join(directory, "coverage-core.json"),
    JSON.stringify({ byFile, seconds }) + "\n",
  )
}

function plan(mutant, core, cellCoverage) {
  const lines = [mutant.statementLine]
  for (let line = mutant.line; line <= mutant.endLine; line += 1)
    lines.push(line)
  const steps = []
  const coreTests = Object.entries(core.byFile[mutant.file] || {})
    .filter(([, covered]) => lines.some((line) => covered.includes(line)))
    .map(([test]) => test)
    .sort((a, b) => core.seconds[a] - core.seconds[b])
  const loading = Object.keys(core.byFile[mutant.file] || {}).sort(
    (a, b) => core.seconds[a] - core.seconds[b],
  )
  if (coreTests.length > 0) steps.push({ pool: "core", tests: coreTests })
  for (const cell of packageCells()) {
    const from =
      cell.key === "nestjs-platform-express-12"
        ? "nestjs-platform-express-11"
        : cell.key
    const covered = (cellCoverage[mutant.file] || {})[
      `node${NODE_MAJOR}-${from}`
    ]
    if (!covered || !lines.some((line) => covered.includes(line))) continue
    steps.push({ cell })
  }
  if (steps.length === 0) {
    if (loading.length > 0) steps.push({ pool: "core", tests: loading })
    for (const cell of packageCells()) {
      if ((cellCoverage[mutant.file] || {})[`node${NODE_MAJOR}-${cell.key}`]) {
        steps.push({ cell })
      }
    }
    for (const step of steps) step.unrun = true
  }
  return steps
}

class Lock {
  constructor() {
    this.tail = Promise.resolve()
  }

  run(fn) {
    const next = this.tail.then(fn, fn)
    this.tail = next.catch(() => {})
    return next
  }
}

async function run() {
  const only = process.argv.find((entry) => entry.startsWith("--only="))
  const pattern = only ? new RegExp(only.split("=")[1]) : null
  const ids = process.argv.find((entry) => entry.startsWith("--ids="))
  const wanted = ids
    ? new Set(
        fs.readFileSync(ids.split("=")[1], "utf8").split("\n").filter(Boolean),
      )
    : null
  const core = JSON.parse(
    fs.readFileSync(path.join(directory, "coverage-core.json"), "utf8"),
  )
  const cellCoverage = JSON.parse(
    fs.readFileSync(
      path.join(results, "baseline", "coverage-cells.json"),
      "utf8",
    ),
  )
  const done = new Set()
  if (fs.existsSync(record)) {
    for (const line of fs.readFileSync(record, "utf8").split("\n")) {
      if (line) done.add(JSON.parse(line).id)
    }
  }
  const sources = {}
  const mutants = []
  for (const file of sourceFiles(path.join(root, "src"))) {
    if (pattern && !pattern.test(file)) continue
    sources[file] = fs.readFileSync(path.join(root, file), "utf8")
    for (const mutant of generate(file, sources[file])) {
      if (done.has(mutant.id)) continue
      if (!wanted || wanted.has(mutant.id)) mutants.push(mutant)
    }
  }
  mutants.sort((a, b) => (a.id < b.id ? -1 : 1))
  console.log(`${mutants.length} changes to run, ${done.size} already recorded`)

  const freeCore = []
  for (let index = 1; index <= CORE_TREES; index += 1)
    freeCore.push(`core-${index}`)
  const waitingCore = []
  const takeCore = () =>
    new Promise((resolve) => {
      if (freeCore.length > 0) resolve(freeCore.pop())
      else waitingCore.push(resolve)
    })
  const giveCore = (name) => {
    if (waitingCore.length > 0) waitingCore.shift()(name)
    else freeCore.push(name)
  }
  const locks = {}
  for (const cell of packageCells()) locks[cell.key] = new Lock()

  async function inTree(name, mutant, args, timeout) {
    const cwd = tree(name)
    const file = path.join(cwd, mutant.file)
    fs.writeFileSync(file, apply(sources[mutant.file], mutant))
    try {
      return await jest(cwd, args, {
        timeout,
        guard: path.join(directory, "net-guard.txt"),
      })
    } finally {
      fs.writeFileSync(file, sources[mutant.file])
    }
  }

  async function one(mutant) {
    const steps = plan(mutant, core, cellCoverage)
    const outcome = { ...mutant, status: "survived", ran: [], seconds: 0 }
    delete outcome.start
    delete outcome.end
    if (steps.length === 0) outcome.status = "uncovered"
    if (steps.some((step) => step.unrun)) outcome.unrun = true
    for (const step of steps) {
      let result
      if (step.pool === "core") {
        const name = await takeCore()
        try {
          const usual = step.tests.reduce(
            (sum, test) => sum + core.seconds[test] * 1000,
            0,
          )
          result = await inTree(
            name,
            mutant,
            ["--runInBand", "--bail", ...step.tests],
            Math.max(MUTANT_TIMEOUT_FLOOR_MS, usual * MUTANT_TIMEOUT_FACTOR),
          )
        } finally {
          giveCore(name)
        }
        outcome.ran.push("core")
      } else {
        result = await locks[step.cell.key].run(() =>
          inTree(step.cell.key, mutant, cellArgs(step.cell), CELL_TIMEOUT_MS),
        )
        outcome.ran.push(step.cell.key)
      }
      outcome.seconds += result.seconds
      if (result.timedOut) {
        outcome.status = "timeout"
        outcome.by = outcome.ran[outcome.ran.length - 1]
        break
      }
      if (result.code !== 0) {
        outcome.status = "killed"
        outcome.by = outcome.ran[outcome.ran.length - 1]
        outcome.test = result.failed[0] || null
        break
      }
    }
    outcome.seconds = Math.round(outcome.seconds * 10) / 10
    fs.appendFileSync(record, JSON.stringify(outcome) + "\n")
  }

  let next = 0
  let finished = 0
  async function worker() {
    while (next < mutants.length) {
      const mutant = mutants[next]
      next += 1
      await one(mutant)
      finished += 1
      if (finished % 100 === 0) console.log(`${finished}/${mutants.length}`)
    }
  }
  await Promise.all(Array.from({ length: IN_FLIGHT }, worker))
  console.log("done")
}

const command = process.argv[2]
const main =
  command === "prepare"
    ? async () => {
        prepare()
        await coverage()
      }
    : command === "run"
      ? run
      : null
if (!main) {
  console.error(
    "usage: tools/bin/mutate prepare | run [--only=<file pattern>] [--ids=<file with one id per line>]",
  )
  process.exit(64)
}
main().catch((error) => {
  console.error(error)
  process.exit(1)
})
