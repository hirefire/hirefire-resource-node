#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."

count="${TOOLS_SLOTS:-9}"

compose() {
  docker compose -p "$(bin/worktree compose-project)" \
    -f docker-compose.yml -f tools/docker-compose.yml "$@"
}

redis_port() {
  compose port --index "$1" redis 6379 | cut -d: -f2
}

postgres_port() {
  compose port postgres 5432 | cut -d: -f2
}

slot_env() {
  slot="$1"
  redis="$(redis_port "$slot")"
  postgres="$(postgres_port)"
  database="tools_${slot}"
  exists="$(compose exec -T postgres psql -U postgres -tAc \
    "SELECT 1 FROM pg_database WHERE datname = '${database}'")"
  if [ "$exists" != "1" ]; then
    compose exec -T postgres createdb -U postgres "$database"
  fi
  printf 'REDIS_PORT=%s\nREDIS_URL=redis://127.0.0.1:%s/0\n' "$redis" "$redis"
  printf 'POSTGRES_PORT=%s\nDATABASE_URL=postgres://postgres:postgres@127.0.0.1:%s/%s\n' \
    "$postgres" "$postgres" "$database"
}

case "${1:-}" in
  up)
    compose up -d --wait --scale "redis=${count}"
    rm -f .env
    bin/services up
    ;;
  env) slot_env "${2:?slot}" ;;
  tls)
    mkdir -p tools/results/tls
    if [ ! -f tools/results/tls/redis.crt ]; then
      (
        cd tools/results/tls
        openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj "/CN=tools-ca" \
          -keyout ca.key -out ca.crt 2>/dev/null
        openssl req -newkey rsa:2048 -nodes -subj "/CN=127.0.0.1" \
          -keyout redis.key -out redis.csr 2>/dev/null
        printf 'subjectAltName=IP:127.0.0.1' > san.cnf
        openssl x509 -req -in redis.csr -CA ca.crt -CAkey ca.key -CAcreateserial \
          -days 30 -extfile san.cnf -out redis.crt 2>/dev/null
        chmod 644 redis.key
      )
    fi
    compose --profile tls up -d redis-tls >&2
    compose --profile tls port redis-tls 6379 | cut -d: -f2
    ;;
  status) compose ps ;;
  down)
    compose down
    rm -f .env
    ;;
  *)
    echo "usage: tools/bin/services {up|env <slot>|tls|status|down}" >&2
    exit 1
    ;;
esac
