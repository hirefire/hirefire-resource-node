{
  "name": "hirefire-resource",
  "version": "2.0.0",
  "description": "Integrates Node.js applications with HireFire autoscalers by pushing app metrics.",
  "keywords": [
    "hirefire",
    "heroku",
    "autoscale",
    "autoscaling",
    "autoscaler",
    "web",
    "worker",
    "dyno"
  ],
  "homepage": "https://hirefire.io",
  "author": "Michael van Rooijen <support@hirefire.io>",
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src",
    "types"
  ],
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./configuration": {
      "types": "./types/configuration.d.ts",
      "default": "./src/configuration.js"
    },
    "./middleware/connect": {
      "types": "./types/middleware/connect.d.ts",
      "default": "./src/middleware/connect.js"
    },
    "./middleware/express": {
      "types": "./types/middleware/express.d.ts",
      "default": "./src/middleware/express.js"
    },
    "./middleware/koa": {
      "types": "./types/middleware/koa.d.ts",
      "default": "./src/middleware/koa.js"
    },
    "./middleware/fastify": {
      "types": "./types/middleware/fastify.d.ts",
      "default": "./src/middleware/fastify.js"
    },
    "./middleware/next": {
      "types": "./types/middleware/next.d.ts",
      "default": "./src/middleware/next.js"
    },
    "./macro/bull": {
      "types": "./types/macro/bull.d.ts",
      "default": "./src/macro/bull.js"
    },
    "./macro/bullmq": {
      "types": "./types/macro/bullmq.d.ts",
      "default": "./src/macro/bullmq.js"
    },
    "./macro/pg-boss": {
      "types": "./types/macro/pg_boss.d.ts",
      "default": "./src/macro/pg_boss.js"
    },
    "./macro/pg_boss": {
      "types": "./types/macro/pg_boss.d.ts",
      "default": "./src/macro/pg_boss.js"
    }
  },
  "typesVersions": {
    "*": {
      "configuration": [
        "./types/configuration.d.ts"
      ],
      "middleware/*": [
        "./types/middleware/*.d.ts"
      ],
      "macro/pg-boss": [
        "./types/macro/pg_boss.d.ts"
      ],
      "macro/*": [
        "./types/macro/*.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirefire/hirefire-resource-node.git"
  },
  "bugs": {
    "url": "https://github.com/hirefire/hirefire-resource-node/issues",
    "email": "support@hirefire.io"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bin/matrix",
    "test:core": "bin/run-cell core",
    "check": "prettier --check --no-semi . && npm run build:types && tsc -p test/types/tsconfig.json",
    "format": "prettier --write --no-semi .",
    "build:types": "node bin/clean-types && tsc",
    "prepack": "npm run build:types"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/load-env.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/support.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ioredis": "^5.4.1",
    "jest": "^29.3.1",
    "nock": "^13.3.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "typescript": "^6.0.3"
  }
}
