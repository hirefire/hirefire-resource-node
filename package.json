{
  "name": "hirefire-resource",
  "version": "1.3.0",
  "description": "HireFire integration library for Node.js applications",
  "keywords": [
    "hirefire",
    "heroku",
    "autoscale",
    "autoscaling",
    "autoscaler",
    "web",
    "worker",
    "dyno"
  ],
  "homepage": "https://hirefire.io",
  "author": "Michael van Rooijen <support@hirefire.io>",
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src",
    "types"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./configuration": {
      "types": "./types/configuration.d.ts",
      "default": "./src/configuration.js"
    },
    "./middleware/connect": {
      "types": "./types/middleware/connect.d.ts",
      "default": "./src/middleware/connect.js"
    },
    "./middleware/express": {
      "types": "./types/middleware/express.d.ts",
      "default": "./src/middleware/express.js"
    },
    "./middleware/koa": {
      "types": "./types/middleware/koa.d.ts",
      "default": "./src/middleware/koa.js"
    },
    "./middleware/fastify": {
      "types": "./types/middleware/fastify.d.ts",
      "default": "./src/middleware/fastify.js"
    },
    "./middleware/next": {
      "types": "./types/middleware/next.d.ts",
      "default": "./src/middleware/next.js"
    },
    "./macro/bullmq": {
      "types": "./types/macro/bullmq.d.ts",
      "default": "./src/macro/bullmq.js"
    }
  },
  "typesVersions": {
    "*": {
      "configuration": [
        "./types/configuration.d.ts"
      ],
      "middleware/*": [
        "./types/middleware/*.d.ts"
      ],
      "macro/*": [
        "./types/macro/*.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirefire/hirefire-resource-node.git"
  },
  "bugs": {
    "url": "https://github.com/hirefire/hirefire-resource-node/issues"
  },
  "scripts": {
    "test": "bin/matrix",
    "test:core": "bin/run-cell core",
    "check": "prettier --check --no-semi .",
    "format": "prettier --write --no-semi .",
    "build:types": "tsc",
    "prepack": "npm run build:types"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/load-env.js"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "jest": "^29.3.1",
    "nock": "^13.3.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "typescript": "^6.0.3"
  }
}
