#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat >&2 <<'EOF'
Usage: bin/run-cell <package> <major> <testfile>
       bin/run-cell core

Runs one matrix cell: installs <package>@<major> (--no-save) and runs <testfile>.
"core" runs the full suite minus the version-pinned integration files.
Cells are defined in test/matrix.json. Run them all with bin/matrix.

Example: bin/run-cell express 5 test/middleware/express.test.js
EOF
  exit 64
}

package="${1:-}"
[ -n "$package" ] || usage

if [ "$package" = "core" ]; then
  ignore="$(jq -r '[.integrations[] | select(.package != "core") | .test] | join("|")' test/matrix.json)"
  exec npx --no-install jest --testPathIgnorePatterns "$ignore"
fi

major="${2:-}"
testfile="${3:-}"
if [ -z "$major" ] || [ -z "$testfile" ]; then
  usage
fi

if [ "$package" = "bullmq" ] || [ "$package" = "bull" ]; then
  npm install "${package}@${major}" ioredis --no-save --no-audit --no-fund --silent
elif [ "$package" = "@nestjs/platform-express" ]; then
  nest_pkgs=("${package}@${major}" "@nestjs/core@${major}" "@nestjs/common@${major}" reflect-metadata)
  if [ "$major" -ge 12 ]; then
    nest_pkgs+=(jest-light-runner)
  fi
  npm install "${nest_pkgs[@]}" --no-save --no-audit --no-fund --silent
else
  npm install "${package}@${major}" --no-save --no-audit --no-fund --silent
fi
if [ "$package" = "pg-boss" ] || [ "$package" = "bullmq" ] || [ "$package" = "bull" ]; then
  exec npx --no-install jest --runInBand "$testfile"
fi
if [ "$package" = "@nestjs/platform-express" ] && [ "$major" -ge 12 ]; then
  exec npx --no-install jest --runner=jest-light-runner "$testfile"
fi
exec npx --no-install jest "$testfile"
