#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat >&2 <<'EOF'
Usage: bin/run-cell <package> <major> <testfile>
       bin/run-cell core

Runs one matrix cell: installs <package>@<major> (--no-save) and runs <testfile>.
"core" runs the full suite minus the version-pinned integration files.
Cells are defined in test/matrix.json. Run them all with bin/matrix.

Example: bin/run-cell express 5 test/middleware/express.test.js
EOF
  exit 64
}

package="${1:-}"
[ -n "$package" ] || usage

if [ "$package" = "core" ]; then
  # Ignore every integration test claimed by the matrix. Core runs the rest.
  ignore="$(jq -r '[.integrations[] | select(.package != "core") | .test] | join("|")' test/matrix.json)"
  exec npx --no-install jest --testPathIgnorePatterns "$ignore"
fi

major="${2:-}"
testfile="${3:-}"
if [ -z "$major" ] || [ -z "$testfile" ]; then
  usage
fi

# Install the matrix package in the same npm invocation as any extra peers.
# A second `npm install --no-save` prunes packages that are not in package.json,
# which would drop the matrix package just installed above.
if [ "$package" = "bullmq" ]; then
  # BullMQ 6 lists ioredis as an optional peer. The macro and live tests still require it.
  npm install "${package}@${major}" ioredis --no-save --no-audit --no-fund --silent
else
  npm install "${package}@${major}" --no-save --no-audit --no-fund --silent
fi
# pg-boss matrix path is a prefix matching integration + lifecycle + plan suites.
# runInBand keeps Pool spy lifecycle tests from racing real Pool integration in one worker.
if [ "$package" = "pg-boss" ]; then
  exec npx --no-install jest --runInBand "$testfile"
fi
exec npx --no-install jest "$testfile"
