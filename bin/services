#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required: https://www.docker.com/products/docker-desktop/" >&2
    exit 1
  fi
}

up() {
  require_docker

  if [ -z "$(docker compose ps --status running --quiet)" ]; then
    docker compose up -d --wait
    started=1
  else
    echo "Already up."
    started=0
  fi

  redis_port="$(docker compose port redis 6379 | cut -d: -f2)"
  postgres_port="$(docker compose port postgres 5432 | cut -d: -f2)"

  if [ -z "$redis_port" ] || [ -z "$postgres_port" ]; then
    echo "Could not determine the published ports." >&2
    exit 1
  fi

  if [ "$started" -eq 1 ] || [ ! -f .env ]; then
    {
      printf 'REDIS_PORT=%s\nREDIS_URL=redis://localhost:%s/0\n' "$redis_port" "$redis_port"
      printf 'POSTGRES_PORT=%s\nDATABASE_URL=postgres://postgres:postgres@localhost:%s/postgres\n' \
        "$postgres_port" "$postgres_port"
    } > .env
  fi

  echo "Redis -> localhost:${redis_port}"
  echo "Postgres -> localhost:${postgres_port}"
}

down() {
  if command -v docker >/dev/null 2>&1 && [ -n "$(docker compose ps --all --quiet)" ]; then
    docker compose down
  else
    echo "Already down."
  fi

  rm -f .env
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  status) require_docker; docker compose ps ;;
  restart) down; up ;;
  logs) require_docker; docker compose logs -f "${@:2}" ;;
  *)
    echo "usage: bin/services {up|down|status|restart|logs}" >&2
    exit 1
    ;;
esac
